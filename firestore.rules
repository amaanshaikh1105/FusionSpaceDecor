rules_version = '2';

// See CLAUDE.md §8 for the intent behind these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{projectId} {
      // Public visitors can only read published projects, and their query must
      // filter on published — Firestore evaluates read rules against the query,
      // not the returned documents. A signed-in admin can read drafts too,
      // otherwise unpublished work would be invisible in the admin panel.
      allow read: if resource.data.published == true || request.auth != null;
      allow write: if request.auth != null;
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /enquiries/{enquiryId} {
      // The contact form is unauthenticated by necessity, so constrain what it
      // can write: known fields only, and bounded sizes. Without this, anyone
      // can fill the collection with arbitrary documents.
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'phone', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 4000;
      allow read, update, delete: if request.auth != null;
    }
  }
}
